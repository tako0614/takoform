{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "takoform-schema-origin",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "forms.takoform.com/schemas/*",
      "zone_name": "takoform.com"
    }
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
