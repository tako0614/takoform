{
  "format": "takoform.core-trust-profile@v1",
  "status": "core-format",
  "packageIdentity": {
    "canonicalization": "RFC8785",
    "encoding": "UTF-8 I-JSON",
    "digest": "sha256",
    "signedSubject": "RFC8785 bytes of package-index.json",
    "archiveBytesAreIdentity": false
  },
  "signature": {
    "format": "application/vnd.dev.sigstore.bundle.v0.3+json",
    "mode": "keyless-message-signature",
    "offlineVerification": true,
    "transparencyLogInclusionRequired": true,
    "ambientTrustedRoot": false,
    "verifiedCertificateCommits": {
      "sourceCommitExtension": "SourceRepositoryDigest",
      "workflowCommitExtension": "BuildSignerDigest",
      "buildConfigCommitExtension": "BuildConfigDigest",
      "format": "non-null-lowercase-40-hex-git-commit",
      "callerSuppliedFallback": false,
      "requireEquality": false
    }
  },
  "publisherPolicy": {
    "callerSupplied": true,
    "requiredExactFields": [
      "oidcIssuer",
      "sourceRepository",
      "workflow",
      "ref"
    ],
    "publisherClassField": false,
    "officialTrustBypass": false,
    "defaultPublisher": false
  },
  "revocation": {
    "statementIdentity": "trust.forms.takoform.com/v1",
    "checkpointIdentity": "trust.forms.takoform.com/v1",
    "identityIsDataFormatWithinAPIV1": true,
    "genesis": {
      "checkpointVersion": "0.0.0",
      "sequence": 0,
      "previousCheckpointDigest": null,
      "entries": 0,
      "signatureRequired": true
    },
    "nonGenesisRequiresEntryAndPredecessor": true,
    "retainedV1Alpha1": {
      "statementIdentity": "trust.forms.takoform.com/v1alpha1",
      "checkpointIdentity": "trust.forms.takoform.com/v1alpha1",
      "initialSequence": 1,
      "nullInitialPredecessor": true
    },
    "appendOnly": true,
    "previousCheckpointDigest": "sha256",
    "callerSuppliedPreviousPin": true,
    "pinIncludesCheckpointIdentityForCurrentProfile": true,
    "crossProfileAdvance": false,
    "notRevokedFormRefProfileBound": true,
    "rejectRollbackForkOrPrefixRewrite": true,
    "blockCreateUpdateAndActivation": true,
    "retainReferencedBytesForObserveDeleteOrEvacuation": true,
    "replaceBytesInPlace": false
  },
  "contentPolicy": {
    "dataOnly": true,
    "allowSymlinks": false,
    "allowExecutableFiles": false,
    "allowCredentialsOrOperatorFields": false,
    "allowExecutableValidationOrAdapterCode": false
  },
  "separateFacts": [
    "verified",
    "published",
    "installed",
    "supported",
    "activated",
    "provisioned",
    "client-supported",
    "offered"
  ]
}
