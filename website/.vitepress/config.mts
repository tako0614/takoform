import { readFileSync } from "node:fs";
import path from "node:path";
import { defineConfig, type DefaultTheme } from "vitepress";
import { fileURLToPath } from "node:url";

const configDirectory = path.dirname(fileURLToPath(import.meta.url));

// Pages rarely carry a frontmatter description. Fall back to the first prose
// paragraph of the Markdown source so a shared link describes the actual page
// rather than repeating the site blurb.
function firstParagraph(srcDir, relativePath) {
  try {
    const raw = readFileSync(path.join(srcDir, relativePath), "utf8");
    const body = raw.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n?/, "");
    for (const line of body.split("\n")) {
      const text = line.trim();
      if (
        text === "" ||
        text.startsWith("#") ||
        text.startsWith("<") ||
        text.startsWith("```") ||
        text.startsWith("---") ||
        text.startsWith(":::") ||
        text.startsWith("|")
      )
        continue;
      const plain = text
        .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
        .replace(/<[^>]+>/g, "")
        .replace(/\{#[^}]+\}/g, "")
        .replace(/[*_`~]/g, "")
        .replace(/\s+/g, " ")
        .trim();
      if (plain !== "") return plain.slice(0, 200);
    }
  } catch {
    // Fall back to the site-level description below.
  }
  return undefined;
}

// takoform.com — the API and common-model-only site this repository owns.
//
// A local build carries the frozen normative Host API v1/common-model closure,
// the published, fixed English Host API v2 contract, non-normative indexes and
// presentation, the exact public schema bytes at the paths their $id names,
// and conformance language.
// Published Form definitions, family-specific examples, publisher
// catalogs, and third-party client adapter pages are not served here; each belongs to the
// publisher or adapter that owns it.
//
// Pages under /spec/ and every file under public/schemas/ are generated by
// scripts/site.mjs and checked byte-for-byte by `bun run check:site`. A /spec/
// v1 mirror is normative only when v1.freeze.json lists its source. V2 mirrors
// declare authority and version status separately; navigation and indexes
// are non-normative.

// Table code keeps whole words (custom.css): a narrow column must not split
// `value` into "valu|e". This rule gives code in table cells break
// opportunities after inner runs of the separators / . : _ - (so
// `private_inputs_conflict` may wrap after an underscore) and every 16 digits
// of a long hex run. A piece with a word over 20 characters, and each 16-digit
// piece of a hex run, is wrapped in a table-break-anywhere span that may break
// anywhere as a last resort; short words such as `sha256:` stay whole. <wbr>
// and the span add no text, so copying and search see the original token.
const SEPARATOR_RUN = /(?<=[^\s/.:_-])[/.:_-]+(?=[^\s/.:_-])/gu;
const HEX_RUN = /([0-9a-f]{16})(?=[0-9a-f])/gu;

export function breakTableCode(md) {
  md.core.ruler.push("takoform_table_code_breaks", (state) => {
    let cells = 0;
    for (const token of state.tokens) {
      if (token.type === "td_open") cells++;
      else if (token.type === "td_close") cells--;
      else if (cells > 0 && token.type === "inline")
        for (const child of token.children ?? []) {
          if (child.type !== "code_inline" || child.meta?.takoformPieces) continue;
          const pieces = child.content.replace(SEPARATOR_RUN, "$&\u0000").replace(HEX_RUN, "$1\u0000").split("\u0000");
          child.meta = {
            ...child.meta,
            takoformPieces: pieces.map((text) => ({
              text,
              long: text.split(/\s+/u).some((word) => word.length > 20) || /^[0-9a-f]{16}$/u.test(text),
            })),
          };
        }
    }
  });
  const render = md.renderer.rules.code_inline;
  md.renderer.rules.code_inline = (tokens, index, options, env, self) => {
    const pieces = tokens[index].meta?.takoformPieces;
    if (!pieces) return render(tokens, index, options, env, self);
    const html = pieces.map(({ text, long }) => {
      const escaped = md.utils.escapeHtml(text);
      return long ? `<span class="table-break-anywhere">${escaped}</span>` : escaped;
    });
    return `<code${self.renderAttrs(tokens[index])}>${html.join("<wbr>")}</code>`;
  };
}

// VitePress names each heading permalink from the heading's raw inline source,
// so a custom `{#id}` (including retained Japanese fragment IDs) leaks into the
// accessible name. Rename them from the rendered heading text instead, after
// markdown-it-anchor has inserted the links.
function nameHeadingPermalinks(md) {
  md.core.ruler.after("anchor", "takoform_permalink_names", (state) => {
    state.tokens.forEach((token, index) => {
      if (token.type !== "heading_open") return;
      const children = state.tokens[index + 1]?.children ?? [];
      const permalink = children.find((child) =>
        child.type === "link_open" &&
        (child.attrGet("class") ?? "").split(/\s+/u).includes("header-anchor"),
      );
      if (permalink === undefined) return;
      // VitePress keeps entity markup in text tokens; decode it once so the
      // renderer's attribute escaping does not double-escape it.
      const title = md.utils.unescapeAll(children
        .map((child) => {
          if (["text", "code_inline", "emoji"].includes(child.type)) return child.content;
          return ["softbreak", "hardbreak"].includes(child.type) ? " " : "";
        })
        .join(""))
        .replace(/\s+/gu, " ")
        .trim();
      permalink.attrSet("aria-label", title === "" ? "Permalink" : `Permalink to "${title}"`);
    });
  });
}

